# Copy to .env and fill in. .env is git-ignored; this file is the documented contract.
# Every variable is validated at startup in apps/api/src/config.ts.

# --- api ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# The single browser origin allowed to call the API (Vite dev server in development).
CORS_ORIGIN=http://localhost:5173

# Phase 3 adds: DATABASE_URL, JWT secrets
# Phase 4 adds: S3 endpoint, bucket and access keys
