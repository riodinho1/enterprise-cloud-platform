# Copy to .env and fill in. .env is git-ignored; this file is the documented contract.
# Every variable is validated at startup in apps/api/src/config.ts.

# --- api ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# The single browser origin allowed to call the API (Vite dev server in development).
CORS_ORIGIN=http://localhost:5173
# Number of trusted reverse proxies in front of the API: 0 in development, 1 behind nginx in Docker.
TRUST_PROXY=0

# --- database (Phase 3) ---
# Read by Docker Compose to create the local PostgreSQL user and database.
POSTGRES_USER=ecp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecp
# Read by the API and by Prisma. Must agree with the three values above.
DATABASE_URL=postgresql://ecp:change-me@127.0.0.1:5432/ecp
# Separate database for automated tests (tables are truncated between tests).
# Created automatically by docker/postgres/init on the first start.
TEST_DATABASE_URL=postgresql://ecp:change-me@127.0.0.1:5432/ecp_test

# --- auth (Phase 3) ---
# At least 32 characters of randomness. Generate with:
#   Git Bash:   openssl rand -hex 32
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
JWT_ACCESS_SECRET=
# Access token lifetime (15 minutes) and refresh token lifetime (7 days), in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Browser-visible path of the auth routes. The refresh cookie is only ever sent to this path.
# It is /api/auth because the Vite proxy (and nginx from Phase 5) forward /api/* to the API.
REFRESH_COOKIE_PATH=/api/auth
# Login, register and refresh attempts allowed per IP address per 15 minutes.
AUTH_RATE_LIMIT_MAX=10

# --- seed (local development only; the seed script refuses to run in production) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- object storage (Phase 4) ---
# Local: SeaweedFS in Docker Compose speaks the S3 API (SIMULATED stand-in for Amazon S3).
# The two keys are read by Compose (to configure SeaweedFS) and by the API (to talk to it).
# Generate each with:  openssl rand -hex 16
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=ecp-documents
# Separate bucket for automated tests; emptied at the start of every run.
TEST_S3_BUCKET=ecp-documents-test
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style URLs (http://host/bucket/key). Required by most self-hosted S3 servers.
S3_FORCE_PATH_STYLE=true

# --- uploads (Phase 4) ---
# Hard limit per file, in bytes (25 MiB). Requests above it are rejected with 413.
UPLOAD_MAX_BYTES=26214400
# off: uploads are marked CLEAN immediately. clamav: uploads wait for the Phase 7 scan worker.
MALWARE_SCAN=off
